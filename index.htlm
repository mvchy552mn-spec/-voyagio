<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WHOLE MELT — Premium Cannabis Extracts</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Rajdhani:wght@300;400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<style>
  :root {
    --neon-pink: #ff2d78;
    --neon-violet: #b847ff;
    --neon-blue: #00d4ff;
    --neon-purple: #7c3aed;
    --deep-black: #020005;
    --card-bg: rgba(12, 4, 25, 0.85);
    --glass: rgba(255,255,255,0.04);
    --glass-border: rgba(255,255,255,0.08);
    --glow-pink: 0 0 30px rgba(255,45,120,0.6), 0 0 60px rgba(255,45,120,0.3);
    --glow-violet: 0 0 30px rgba(184,71,255,0.6), 0 0 60px rgba(184,71,255,0.3);
    --glow-blue: 0 0 30px rgba(0,212,255,0.6), 0 0 60px rgba(0,212,255,0.3);
    --font-display: 'Orbitron', monospace;
    --font-body: 'Rajdhani', sans-serif;
    --font-mono: 'Space Mono', monospace;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; overflow-x: hidden; }

  body {
    background: var(--deep-black);
    color: #fff;
    font-family: var(--font-body);
    overflow-x: hidden;
    cursor: none;
  }

  /* ─── CUSTOM CURSOR ─── */
  .cursor {
    width: 12px; height: 12px;
    background: var(--neon-pink);
    border-radius: 50%;
    position: fixed;
    top: 0; left: 0;
    pointer-events: none;
    z-index: 99999;
    transform: translate(-50%, -50%);
    transition: transform 0.1s, background 0.3s;
    box-shadow: var(--glow-pink);
    mix-blend-mode: screen;
  }
  .cursor-ring {
    width: 38px; height: 38px;
    border: 1.5px solid rgba(255,45,120,0.5);
    border-radius: 50%;
    position: fixed;
    top: 0; left: 0;
    pointer-events: none;
    z-index: 99998;
    transform: translate(-50%, -50%);
    transition: transform 0.18s ease, width 0.3s, height 0.3s, border-color 0.3s;
  }
  .cursor-ring.hovered { width: 60px; height: 60px; border-color: var(--neon-violet); }
  .cursor.clicked { transform: translate(-50%, -50%) scale(0.5); }

  /* ─── BACKGROUND CANVAS ─── */
  #bg-canvas {
    position: fixed; top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /* ─── NOISE OVERLAY ─── */
  body::before {
    content: '';
    position: fixed; inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='1'/%3E%3C/svg%3E");
    opacity: 0.025;
    pointer-events: none;
    z-index: 1;
  }

  /* ─── NAVBAR ─── */
  nav {
    position: fixed; top: 0; left: 0; width: 100%;
    z-index: 1000;
    padding: 0 5%;
    height: 80px;
    display: flex; align-items: center; justify-content: space-between;
    backdrop-filter: blur(20px);
    background: rgba(2,0,5,0.6);
    border-bottom: 1px solid rgba(255,45,120,0.12);
    transition: all 0.4s ease;
  }
  nav.scrolled {
    background: rgba(2,0,5,0.9);
    border-bottom-color: rgba(255,45,120,0.25);
    box-shadow: 0 0 40px rgba(255,45,120,0.08);
  }
  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 900;
    letter-spacing: 0.15em;
    background: linear-gradient(135deg, var(--neon-pink), var(--neon-violet));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: none;
    position: relative;
  }
  .nav-logo::after {
    content: 'EXTRACTS';
    display: block;
    font-size: 0.42rem;
    letter-spacing: 0.35em;
    background: linear-gradient(135deg, var(--neon-blue), var(--neon-violet));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-top: -4px;
  }
  .nav-links {
    display: flex; gap: 3rem;
    list-style: none;
  }
  .nav-links a {
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: rgba(255,255,255,0.55);
    text-decoration: none;
    text-transform: uppercase;
    position: relative;
    transition: color 0.3s;
  }
  .nav-links a::after {
    content: '';
    position: absolute; bottom: -4px; left: 0;
    width: 0; height: 1px;
    background: var(--neon-pink);
    box-shadow: var(--glow-pink);
    transition: width 0.3s ease;
  }
  .nav-links a:hover { color: var(--neon-pink); }
  .nav-links a:hover::after { width: 100%; }
  .nav-cta {
    font-family: var(--font-display);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    padding: 10px 24px;
    background: linear-gradient(135deg, var(--neon-pink), var(--neon-violet));
    border: none;
    border-radius: 4px;
    color: #fff;
    cursor: none;
    text-transform: uppercase;
    position: relative;
    overflow: hidden;
    transition: all 0.3s;
    box-shadow: 0 0 20px rgba(255,45,120,0.4);
    text-decoration: none;
  }
  .nav-cta::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.2), transparent);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .nav-cta:hover::before { opacity: 1; }
  .nav-cta:hover { box-shadow: var(--glow-pink); transform: translateY(-1px); }
  .hamburger { display: none; flex-direction: column; gap: 5px; cursor: none; }
  .hamburger span { display: block; width: 28px; height: 2px; background: var(--neon-pink); transition: all 0.3s; }

  /* ─── HERO ─── */
  #hero {
    position: relative; z-index: 2;
    min-height: 100vh;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
    padding-top: 80px;
  }
  .hero-bg-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255,45,120,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,45,120,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    animation: gridShift 20s linear infinite;
  }
  @keyframes gridShift {
    0% { transform: translateY(0); }
    100% { transform: translateY(60px); }
  }
  .hero-glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }
  .orb-1 {
    width: 600px; height: 600px;
    background: radial-gradient(circle, rgba(255,45,120,0.25), transparent 70%);
    top: -100px; left: -150px;
    animation: orbFloat 8s ease-in-out infinite;
  }
  .orb-2 {
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(184,71,255,0.2), transparent 70%);
    bottom: -100px; right: -100px;
    animation: orbFloat 10s ease-in-out infinite reverse;
  }
  .orb-3 {
    width: 400px; height: 400px;
    background: radial-gradient(circle, rgba(0,212,255,0.12), transparent 70%);
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    animation: orbPulse 6s ease-in-out infinite;
  }
  @keyframes orbFloat {
    0%, 100% { transform: translate(0, 0); }
    33% { transform: translate(30px, -20px); }
    66% { transform: translate(-20px, 15px); }
  }
  @keyframes orbPulse {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.8; }
    50% { transform: translate(-50%, -50%) scale(1.15); opacity: 1; }
  }
  .hero-content {
    position: relative; z-index: 3;
    text-align: center;
    max-width: 960px;
    padding: 0 2rem;
  }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.5em;
    color: var(--neon-blue);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.8s 0.3s forwards;
    text-shadow: 0 0 20px rgba(0,212,255,0.8);
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 10vw, 9rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
    opacity: 0;
    animation: fadeUp 0.8s 0.5s forwards;
  }
  .hero-title .line-1 {
    display: block;
    background: linear-gradient(135deg, #fff 0%, rgba(255,255,255,0.8) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-title .line-2 {
    display: block;
    background: linear-gradient(135deg, var(--neon-pink), var(--neon-violet), var(--neon-blue));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 0 30px rgba(255,45,120,0.5));
  }
  .hero-tagline {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2.5vw, 1.4rem);
    font-weight: 300;
    color: rgba(255,255,255,0.55);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 3rem;
    opacity: 0;
    animation: fadeUp 0.8s 0.7s forwards;
  }
  .hero-product-float {
    position: relative;
    width: 240px; height: 240px;
    margin: 0 auto 3rem;
    opacity: 0;
    animation: fadeUp 1s 0.6s forwards, float 6s 1.6s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(-20px) rotate(3deg); }
  }
  .hero-product-float img {
    width: 100%; height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 0 40px rgba(255,45,120,0.5)) drop-shadow(0 0 80px rgba(184,71,255,0.3));
    border-radius: 20px;
  }
  .hero-product-glow {
    position: absolute; inset: -30px;
    background: radial-gradient(circle, rgba(255,45,120,0.2), transparent 70%);
    border-radius: 50%;
    animation: orbPulse 4s ease-in-out infinite;
  }
  .hero-actions {
    display: flex; gap: 1.2rem;
    justify-content: center; align-items: center;
    flex-wrap: wrap;
    opacity: 0;
    animation: fadeUp 0.8s 0.9s forwards;
  }
  .btn-primary {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 16px 42px;
    background: linear-gradient(135deg, var(--neon-pink), var(--neon-violet));
    border: none;
    border-radius: 6px;
    color: #fff;
    cursor: none;
    position: relative;
    overflow: hidden;
    transition: all 0.3s;
    box-shadow: 0 0 30px rgba(255,45,120,0.5), inset 0 1px 0 rgba(255,255,255,0.2);
    text-decoration: none;
    display: inline-block;
  }
  .btn-primary::before {
    content: '';
    position: absolute; top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.5s;
  }
  .btn-primary:hover::before { left: 100%; }
  .btn-primary:hover { box-shadow: var(--glow-pink), inset 0 1px 0 rgba(255,255,255,0.2); transform: translateY(-2px); }
  .btn-ghost {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 15px 42px;
    background: transparent;
    border: 1px solid rgba(255,45,120,0.4);
    border-radius: 6px;
    color: rgba(255,255,255,0.8);
    cursor: none;
    transition: all 0.3s;
    text-decoration: none;
    display: inline-block;
  }
  .btn-ghost:hover {
    border-color: var(--neon-pink);
    color: #fff;
    box-shadow: var(--glow-pink);
    background: rgba(255,45,120,0.08);
    transform: translateY(-2px);
  }
  .hero-scroll-indicator {
    position: absolute; bottom: 2.5rem; left: 50%;
    transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
    opacity: 0;
    animation: fadeIn 1s 1.5s forwards;
    z-index: 3;
  }
  .scroll-text {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.3em;
    color: rgba(255,255,255,0.3);
    text-transform: uppercase;
  }
  .scroll-line {
    width: 1px; height: 50px;
    background: linear-gradient(180deg, rgba(255,45,120,0.8), transparent);
    animation: scrollBob 2s ease-in-out infinite;
  }
  @keyframes scrollBob {
    0%, 100% { transform: scaleY(1); opacity: 1; }
    50% { transform: scaleY(0.5); opacity: 0.3; }
  }
  @keyframes fadeUp {
    0% { opacity: 0; transform: translateY(30px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }

  /* ─── SECTION BASE ─── */
  section { position: relative; z-index: 2; }
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .section-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--neon-pink);
    text-shadow: 0 0 20px rgba(255,45,120,0.8);
    margin-bottom: 1rem;
    display: block;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #fff 0%, rgba(255,255,255,0.7) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.1;
    margin-bottom: 1.2rem;
  }
  .section-subtitle {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 300;
    color: rgba(255,255,255,0.45);
    letter-spacing: 0.05em;
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.7;
  }
  .container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 5%;
  }

  /* ─── PRODUCTS SECTION ─── */
  #products {
    padding: 120px 0;
  }
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 2rem;
    justify-items: center;
  }
  .product-card {
    width: 100%;
    max-width: 480px;
    background: var(--card-bg);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    backdrop-filter: blur(20px);
    transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    transform-style: preserve-3d;
    perspective: 1000px;
    opacity: 0;
    transform: translateY(50px);
  }
  .product-card.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .product-card::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(255,45,120,0.05) 0%, transparent 50%, rgba(184,71,255,0.05) 100%);
    opacity: 0;
    transition: opacity 0.5s;
    border-radius: 20px;
    z-index: 1;
  }
  .product-card:hover::before { opacity: 1; }
  .product-card:hover {
    border-color: rgba(255,45,120,0.35);
    box-shadow: 0 0 60px rgba(255,45,120,0.2), 0 0 120px rgba(184,71,255,0.1), 0 30px 80px rgba(0,0,0,0.5);
    transform: translateY(-10px) scale(1.01);
  }
  .card-badge {
    position: absolute;
    top: 1.2rem; left: 1.2rem;
    z-index: 5;
    font-family: var(--font-display);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 4px;
  }
  .badge-hybrid {
    background: linear-gradient(135deg, rgba(255,45,120,0.25), rgba(184,71,255,0.25));
    border: 1px solid rgba(255,45,120,0.4);
    color: var(--neon-pink);
    box-shadow: 0 0 15px rgba(255,45,120,0.2);
  }
  .badge-indica {
    background: linear-gradient(135deg, rgba(184,71,255,0.25), rgba(0,212,255,0.15));
    border: 1px solid rgba(184,71,255,0.4);
    color: var(--neon-violet);
    box-shadow: 0 0 15px rgba(184,71,255,0.2);
  }
  .badge-sativa {
    background: linear-gradient(135deg, rgba(0,212,255,0.25), rgba(255,200,0,0.15));
    border: 1px solid rgba(0,212,255,0.4);
    color: var(--neon-blue);
    box-shadow: 0 0 15px rgba(0,212,255,0.2);
  }
  .card-img-wrap {
    position: relative;
    height: 280px;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(15,5,30,1) 0%, rgba(5,0,15,1) 100%);
  }
  .card-img-wrap img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.23, 1, 0.32, 1), filter 0.5s;
    filter: brightness(0.9) saturate(1.1);
  }
  .product-card:hover .card-img-wrap img {
    transform: scale(1.08);
    filter: brightness(1) saturate(1.3);
  }
  .card-img-glow {
    position: absolute; bottom: 0; left: 0; right: 0;
    height: 50%;
    background: linear-gradient(0deg, var(--card-bg), transparent);
    z-index: 2;
  }
  .card-img-shine {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.06) 0%, transparent 50%);
    z-index: 3;
    opacity: 0;
    transition: opacity 0.4s;
  }
  .product-card:hover .card-img-shine { opacity: 1; }
  .card-body {
    padding: 1.6rem 1.8rem 1.8rem;
    position: relative; z-index: 2;
  }
  .card-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    color: #fff;
    margin-bottom: 0.7rem;
    line-height: 1.2;
  }
  .card-desc {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 300;
    color: rgba(255,255,255,0.5);
    line-height: 1.65;
    margin-bottom: 1.2rem;
  }
  .card-flavors {
    display: flex; gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.4rem;
  }
  .flavor-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    padding: 5px 12px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 100px;
    color: rgba(255,255,255,0.55);
    letter-spacing: 0.05em;
    transition: all 0.3s;
  }
  .flavor-tag:hover {
    border-color: rgba(255,45,120,0.4);
    color: var(--neon-pink);
    background: rgba(255,45,120,0.08);
  }
  .card-footer {
    display: flex; align-items: center; justify-content: space-between;
    border-top: 1px solid rgba(255,255,255,0.07);
    padding-top: 1.2rem;
    gap: 1rem;
  }
  .card-price {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 900;
    background: linear-gradient(135deg, var(--neon-pink), var(--neon-violet));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.02em;
  }
  .card-price-label {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: rgba(255,255,255,0.3);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-top: -4px;
  }
  .btn-add {
    font-family: var(--font-display);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 13px 26px;
    background: linear-gradient(135deg, var(--neon-pink), var(--neon-violet));
    border: none;
    border-radius: 8px;
    color: #fff;
    cursor: none;
    position: relative;
    overflow: hidden;
    transition: all 0.3s;
    box-shadow: 0 0 20px rgba(255,45,120,0.35);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .btn-add::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.15), transparent);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .btn-add:hover { box-shadow: var(--glow-pink); transform: translateY(-2px); }
  .btn-add:hover::after { opacity: 1; }
  .card-line {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--neon-pink), var(--neon-violet), var(--neon-blue));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s ease;
  }
  .product-card:hover .card-line { transform: scaleX(1); }

  /* ─── STATS STRIP ─── */
  .stats-strip {
    padding: 60px 0;
    border-top: 1px solid rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    background: rgba(255,45,120,0.02);
    margin: 0 0 0 0;
  }
  .stats-inner {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 2rem;
  }
  .stat-item { text-align: center; }
  .stat-num {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    background: linear-gradient(135deg, var(--neon-pink), var(--neon-violet));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: block;
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
  }

  /* ─── COLLECTIONS ─── */
  #collections { padding: 120px 0; }
  .collections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .collection-card {
    position: relative;
    height: 340px;
    border-radius: 16px;
    overflow: hidden;
    cursor: none;
    border: 1px solid var(--glass-border);
    transition: all 0.4s ease;
    opacity: 0;
    transform: translateY(40px);
  }
  .collection-card.visible { opacity: 1; transform: translateY(0); }
  .collection-card:hover {
    border-color: rgba(255,45,120,0.35);
    transform: translateY(-6px);
    box-shadow: 0 0 50px rgba(255,45,120,0.15), 0 20px 60px rgba(0,0,0,0.4);
  }
  .collection-card:nth-child(1) { grid-column: span 2; }
  .collection-bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    transition: transform 0.7s ease;
    filter: brightness(0.35) saturate(1.2);
  }
  .collection-card:hover .collection-bg { transform: scale(1.06); }
  .col-1-bg { background: linear-gradient(135deg, #0a0015, #1a0030, #0d0025), url('') center/cover; background-image: radial-gradient(ellipse at 30% 40%, rgba(255,45,120,0.5) 0%, transparent 60%), radial-gradient(ellipse at 70% 60%, rgba(184,71,255,0.4) 0%, transparent 60%); }
  .col-2-bg { background: radial-gradient(ellipse at 50% 30%, rgba(0,212,255,0.5) 0%, transparent 60%), radial-gradient(ellipse at 50% 80%, rgba(184,71,255,0.4) 0%, transparent 60%); }
  .col-3-bg { background: radial-gradient(ellipse at 40% 50%, rgba(255,45,120,0.5) 0%, transparent 60%), radial-gradient(ellipse at 70% 50%, rgba(0,212,255,0.3) 0%, transparent 60%); }
  .collection-content {
    position: relative; z-index: 2;
    height: 100%;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 2rem;
    background: linear-gradient(0deg, rgba(2,0,5,0.9) 0%, rgba(2,0,5,0.3) 50%, transparent 100%);
  }
  .collection-tag {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.35em;
    color: var(--neon-pink);
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .collection-name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }
  .collection-desc {
    font-size: 0.88rem;
    color: rgba(255,255,255,0.45);
    font-weight: 300;
    line-height: 1.6;
    margin-bottom: 1.2rem;
  }
  .btn-sm {
    font-family: var(--font-display);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 10px 22px;
    background: transparent;
    border: 1px solid rgba(255,45,120,0.5);
    border-radius: 5px;
    color: var(--neon-pink);
    cursor: none;
    display: inline-block;
    transition: all 0.3s;
    text-decoration: none;
    width: fit-content;
  }
  .btn-sm:hover {
    background: var(--neon-pink);
    color: #fff;
    box-shadow: var(--glow-pink);
    transform: translateY(-1px);
  }

  /* ─── BRAND STORY ─── */
  #brand { padding: 120px 0; }
  .brand-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
  }
  .brand-visual {
    position: relative;
    height: 500px;
  }
  .brand-visual-box {
    position: absolute;
    border-radius: 16px;
    overflow: hidden;
  }
  .bvb-main {
    width: 100%; height: 100%;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,45,120,0.15) 0%, rgba(184,71,255,0.15) 50%, rgba(0,212,255,0.1) 100%);
    border: 1px solid rgba(255,45,120,0.2);
    display: flex; align-items: center; justify-content: center;
  }
  .brand-logo-big {
    font-family: var(--font-display);
    font-size: 5rem;
    font-weight: 900;
    background: linear-gradient(135deg, var(--neon-pink), var(--neon-violet));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.05em;
    line-height: 1;
    text-align: center;
    filter: drop-shadow(0 0 30px rgba(255,45,120,0.3));
  }
  .brand-glow-strip {
    position: absolute;
    width: 2px;
    top: 20%; bottom: 20%;
    left: -1px;
    background: linear-gradient(180deg, transparent, var(--neon-pink), var(--neon-violet), transparent);
    box-shadow: var(--glow-pink);
    animation: glowPulse 3s ease-in-out infinite;
  }
  @keyframes glowPulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }
  .brand-card-float {
    position: absolute;
    background: var(--card-bg);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    padding: 1rem 1.4rem;
    backdrop-filter: blur(20px);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: rgba(255,255,255,0.6);
    animation: float 7s ease-in-out infinite;
  }
  .bcf-1 { bottom: 30px; right: -30px; animation-delay: 0s; }
  .bcf-2 { top: 60px; right: -20px; animation-delay: 2s; }
  .bcf-val {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--neon-pink), var(--neon-violet));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: block;
    margin-bottom: 2px;
  }
  .brand-text h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.15;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }
  .brand-text h2 span {
    background: linear-gradient(135deg, var(--neon-pink), var(--neon-violet));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .brand-text p {
    font-size: 1rem;
    font-weight: 300;
    color: rgba(255,255,255,0.5);
    line-height: 1.8;
    margin-bottom: 1.2rem;
  }
  .brand-pillars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }
  .pillar {
    background: var(--glass);
    border: 1px solid var(--glass-border);
    border-radius: 10px;
    padding: 1.2rem;
    transition: all 0.3s;
  }
  .pillar:hover {
    border-color: rgba(255,45,120,0.3);
    background: rgba(255,45,120,0.05);
    box-shadow: 0 0 30px rgba(255,45,120,0.1);
  }
  .pillar-icon {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    display: block;
  }
  .pillar-name {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #fff;
    margin-bottom: 0.3rem;
    text-transform: uppercase;
  }
  .pillar-desc {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.4);
    line-height: 1.5;
  }

  /* ─── MARQUEE ─── */
  .marquee-wrap {
    padding: 30px 0;
    overflow: hidden;
    border-top: 1px solid rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    background: rgba(255,45,120,0.03);
  }
  .marquee-track {
    display: flex;
    gap: 3rem;
    animation: marquee 25s linear infinite;
    width: max-content;
  }
  .marquee-track:hover { animation-play-state: paused; }
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .marquee-item {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.15);
    white-space: nowrap;
    display: flex; align-items: center; gap: 1.5rem;
  }
  .marquee-dot {
    width: 5px; height: 5px;
    background: var(--neon-pink);
    border-radius: 50%;
    box-shadow: var(--glow-pink);
    flex-shrink: 0;
  }
  .marquee-highlight { color: var(--neon-pink); }

  /* ─── WHOLESALE ─── */
  #wholesale { padding: 120px 0; }
  .wholesale-inner {
    background: var(--card-bg);
    border: 1px solid rgba(255,45,120,0.15);
    border-radius: 24px;
    padding: 5rem 4rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(20px);
  }
  .wholesale-inner::before {
    content: '';
    position: absolute;
    top: -50%; left: -50%;
    width: 200%; height: 200%;
    background: conic-gradient(from 0deg at 50% 50%, transparent 0deg, rgba(255,45,120,0.05) 60deg, transparent 120deg, rgba(184,71,255,0.05) 180deg, transparent 240deg, rgba(0,212,255,0.05) 300deg, transparent 360deg);
    animation: rotateBg 20s linear infinite;
  }
  @keyframes rotateBg {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  .wholesale-inner > * { position: relative; z-index: 1; }
  .wholesale-inner h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    color: #fff;
    margin-bottom: 1rem;
  }
  .wholesale-inner p {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.45);
    max-width: 550px;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
    font-weight: 300;
  }
  .wholesale-perks {
    display: flex; justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3rem;
  }
  .perk {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.15em;
    padding: 8px 18px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 100px;
    color: rgba(255,255,255,0.55);
  }

  /* ─── CONTACT ─── */
  #contact { padding: 120px 0; }
  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 5rem;
    align-items: start;
  }
  .contact-info h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 800;
    color: #fff;
    margin-bottom: 1rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .contact-info p {
    font-size: 0.95rem;
    color: rgba(255,255,255,0.4);
    line-height: 1.8;
    font-weight: 300;
    margin-bottom: 2rem;
  }
  .contact-socials {
    display: flex; gap: 1rem;
  }
  .social-link {
    width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 10px;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s;
    cursor: none;
  }
  .social-link:hover {
    border-color: var(--neon-pink);
    background: rgba(255,45,120,0.1);
    box-shadow: 0 0 20px rgba(255,45,120,0.25);
    transform: translateY(-2px);
  }
  .contact-form {
    display: flex; flex-direction: column; gap: 1rem;
  }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-group label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
  }
  .form-group input,
  .form-group textarea,
  .form-group select {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 14px 18px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: #fff;
    outline: none;
    transition: all 0.3s;
    resize: none;
    -webkit-appearance: none;
    appearance: none;
  }
  .form-group select option { background: #0a0015; }
  .form-group input:focus,
  .form-group textarea:focus,
  .form-group select:focus {
    border-color: rgba(255,45,120,0.5);
    background: rgba(255,45,120,0.04);
    box-shadow: 0 0 20px rgba(255,45,120,0.1);
  }
  .form-group input::placeholder,
  .form-group textarea::placeholder { color: rgba(255,255,255,0.2); }

  /* ─── FOOTER ─── */
  footer {
    position: relative; z-index: 2;
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: 4rem 5% 2.5rem;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }
  .footer-brand-col .footer-logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 900;
    background: linear-gradient(135deg, var(--neon-pink), var(--neon-violet));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 0.1em;
    margin-bottom: 0.8rem;
    display: block;
  }
  .footer-brand-col p {
    font-size: 0.88rem;
    color: rgba(255,255,255,0.3);
    line-height: 1.7;
    font-weight: 300;
    max-width: 260px;
  }
  .footer-col h4 {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    margin-bottom: 1.2rem;
  }
  .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 0.65rem; }
  .footer-col ul li a {
    font-size: 0.88rem;
    color: rgba(255,255,255,0.3);
    text-decoration: none;
    transition: color 0.3s;
    display: inline-block;
  }
  .footer-col ul li a:hover { color: var(--neon-pink); }
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.05);
    padding-top: 2rem;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 1rem;
  }
  .footer-bottom p {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: rgba(255,255,255,0.2);
    letter-spacing: 0.1em;
  }
  .footer-disclaimer {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: rgba(255,255,255,0.15);
    letter-spacing: 0.05em;
    text-align: center;
    margin-top: 1.5rem;
    line-height: 1.7;
    max-width: 700px;
    margin-left: auto; margin-right: auto;
  }

  /* ─── AGE GATE ─── */
  .age-gate {
    position: fixed; inset: 0;
    z-index: 99999;
    background: var(--deep-black);
    display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(0);
  }
  .age-gate.hidden { display: none; }
  .age-gate-inner {
    text-align: center;
    max-width: 480px;
    padding: 2rem;
  }
  .age-gate-logo {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 900;
    background: linear-gradient(135deg, var(--neon-pink), var(--neon-violet));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
  }
  .age-gate h2 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.8rem;
    letter-spacing: 0.05em;
  }
  .age-gate p {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.4);
    margin-bottom: 2rem;
    line-height: 1.6;
  }
  .age-gate-btns { display: flex; gap: 1rem; justify-content: center; }
  .age-no {
    font-family: var(--font-display);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    padding: 14px 32px;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 6px;
    color: rgba(255,255,255,0.4);
    cursor: none;
    text-transform: uppercase;
    transition: all 0.3s;
  }
  .age-no:hover { border-color: rgba(255,255,255,0.3); color: rgba(255,255,255,0.7); }

  /* ─── SCROLL REVEAL ─── */
  .reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }

  /* ─── TOAST ─── */
  .toast {
    position: fixed;
    bottom: 2rem; right: 2rem;
    z-index: 10000;
    background: var(--card-bg);
    border: 1px solid rgba(255,45,120,0.3);
    border-radius: 12px;
    padding: 1rem 1.5rem;
    backdrop-filter: blur(20px);
    box-shadow: var(--glow-pink), 0 20px 40px rgba(0,0,0,0.4);
    display: flex; align-items: center; gap: 0.8rem;
    transform: translateX(150%);
    transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);
    max-width: 300px;
  }
  .toast.show { transform: translateX(0); }
  .toast-icon { font-size: 1.3rem; }
  .toast-text {
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: #fff;
    line-height: 1.4;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 1024px) {
    .collections-grid { grid-template-columns: 1fr 1fr; }
    .collection-card:nth-child(1) { grid-column: span 2; }
    .brand-inner { grid-template-columns: 1fr; gap: 3rem; }
    .brand-visual { height: 350px; }
    .footer-top { grid-template-columns: 1fr 1fr; }
    .contact-inner { grid-template-columns: 1fr; gap: 3rem; }
  }
  @media (max-width: 768px) {
    .nav-links { display: none; }
    .nav-cta { display: none; }
    .hamburger { display: flex; }
    .products-grid { grid-template-columns: 1fr; }
    .collections-grid { grid-template-columns: 1fr; }
    .collection-card:nth-child(1) { grid-column: span 1; }
    .brand-pillars { grid-template-columns: 1fr; }
    .footer-top { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; text-align: center; }
    .wholesale-inner { padding: 3rem 2rem; }
    .form-row { grid-template-columns: 1fr; }
    .hero-product-float { width: 180px; height: 180px; }
    .stats-inner { gap: 1.5rem; }
    .brand-visual { height: 280px; }
    .bcf-1, .bcf-2 { display: none; }
    .hero-title { font-size: clamp(2.8rem, 14vw, 6rem); }
    .contact-socials { flex-wrap: wrap; }
    .age-gate-btns { flex-direction: column; }
    .hero-actions { flex-direction: column; }
    .btn-primary, .btn-ghost { width: 100%; text-align: center; }
  }

  /* ─── MOBILE MENU ─── */
  .mobile-nav {
    position: fixed; top: 80px; left: 0; right: 0;
    background: rgba(2,0,5,0.97);
    border-bottom: 1px solid rgba(255,45,120,0.2);
    backdrop-filter: blur(20px);
    z-index: 999;
    padding: 2rem 5%;
    transform: translateY(-110%);
    transition: transform 0.4s cubic-bezier(0.23,1,0.32,1);
    display: flex; flex-direction: column; gap: 1.5rem;
  }
  .mobile-nav.open { transform: translateY(0); }
  .mobile-nav a {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    text-transform: uppercase;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    transition: color 0.3s;
  }
  .mobile-nav a:hover { color: var(--neon-pink); }
  .mobile-nav a:last-child { border-bottom: none; }
</style>
</head>
<body>

<!-- Age Gate -->
<div class="age-gate" id="ageGate">
  <div class="age-gate-inner">
    <div style="margin-bottom:1.5rem;">
